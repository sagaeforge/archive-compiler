struct Node {
    value: i64,
    next: Ptr<Node>
}

fn sum_list(head: Ptr<Node>) -> i64 with mem, mut {
    var total: i64 = 0
    var cur: Ptr<Node> = head
    total = total + (*cur).value
    cur = (*cur).next
    total = total + (*cur).value
    cur = (*cur).next
    total = total + (*cur).value
    total
}

fn main() -> i64 with mem, mut {
    var n3: Node = Node { value: 20, next: 0 as Ptr<Node> }
    var n2: Node = Node { value: 12, next: &n3 as Ptr<Node> }
    var n1: Node = Node { value: 10, next: &n2 as Ptr<Node> }
    sum_list(&n1 as Ptr<Node>)
}
