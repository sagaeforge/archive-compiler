fn make_op(kind: i64, base: i64) -> fn(i64) -> i64 {
    match kind {
        0 => { x: i64 => x + base }
        _ => { x: i64 => x * base }
    }
}

fn main() -> i64 {
    val adder: fn(i64) -> i64 = make_op(0, 10)
    val multiplier: fn(i64) -> i64 = make_op(1, 3)
    val a: i64 = adder(5)
    val b: i64 = multiplier(9)
    a + b
}
