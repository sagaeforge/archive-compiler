union Result<T, E> { Ok(T), Err(E) }

fn safe_div(a: i64, b: i64) -> Result<i64, i64> {
    if b == 0 {
        Result<i64, i64>::Err(99)
    } else {
        Result<i64, i64>::Ok(a / b)
    }
}

fn compute() -> Result<i64, i64> {
    val a: i64 = safe_div(10, 0)?
    Result<i64, i64>::Ok(a)
}

fn main() -> i64 {
    val r: Result<i64, i64> = compute()
    match r {
        Ok(v) => v
        Err(e) => e
    }
}
