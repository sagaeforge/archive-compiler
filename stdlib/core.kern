fn mem_cmp(a: Ptr<u8>, b: Ptr<u8>, n: u64) -> i64 = intrinsic

// --- Pointer arithmetic intrinsics ---
fn ptr_add_bytes(ptr: Ptr<u8>, n: u64) -> Ptr<u8> = intrinsic
fn ptr_sub_bytes(ptr: Ptr<u8>, n: u64) -> Ptr<u8> = intrinsic

// --- Atomic intrinsics ---
