// Module system example
namespace Physics {
    using Vector = std::collections::Vector;
    using namespace std::math;

    // 타입 별칭
    using Force = Vector<f32>;
    using Position = Vector<f32>;
    using Velocity = Vector<f32>;

    // 네임스페이스 별칭
    using Vec = std::collections::Vector;
    using Math = std::math;

    // 정적 멤버 접근
    let gravity = Physics::Constants::GRAVITY;
    let maxSpeed = Physics::Constants::MAX_SPEED;

    // 인스턴스 멤버 접근
    let force = Force::new();
    force.magnitude = 9.8;
    force.direction = Vector::new(0.0, -1.0, 0.0);

    // 옵셔널 체이닝
    let optionalForce = some(force);
    let magnitude = optionalForce?.magnitude;

    // 제네릭 타입 제약이 있는 함수
    fn calculateForce<T: PhysicsObject>(object: T) -> Force {
        return object.mass * Physics::Constants::GRAVITY;
    }

    // 화살표 함수
    fn getGravity() -> f32 => Physics::Constants::GRAVITY;

    // 블록 함수
    fn applyForce(force: Force, object: PhysicsObject) {
        object.velocity += force / object.mass;
        object.position += object.velocity * Physics::Constants::DELTA_TIME;
    }
}

// 중첩된 네임스페이스
namespace Physics::Simulation {
    using namespace Physics;  // 부모 네임스페이스 사용

    fn simulate(objects: Vector<PhysicsObject>) {
        for object in objects {
            let force = Physics::calculateForce(object);
            Physics::applyForce(force, object);
        }
    }
}

// using 지시문의 스코프
{
    using namespace Physics::Simulation;
    let objects = Vector::new();
    simulate(objects);  // Physics::Simulation::simulate를 직접 사용
}

// 타입 별칭과 제네릭
using PhysicsObject = struct {
    mass: f32,
    position: Physics::Position,
    velocity: Physics::Velocity
};

// 네임스페이스 별칭 사용
using Sim = Physics::Simulation;
let result = Sim::simulate(objects);

// 정적 멤버와 인스턴스 멤버 접근
let constants = Physics::Constants;  // 정적 멤버
let object = PhysicsObject::new();   // 정적 메서드
object.position = Vector::new(0.0, 0.0, 0.0);  // 인스턴스 멤버

// 옵셔널 체이닝과 안전한 접근
let optionalObject = some(object);
let position = optionalObject?.position;
let velocity = optionalObject?.velocity ?? Vector::new(0.0, 0.0, 0.0);

// Run the async main function
main().catch(error => console.error(error));

// 3. 제네릭과 고차 제네릭
// 3.1 기본 제네릭 선언
public struct Container<T> {
    private _items: Vector<T>;

    public fn add(item: T): void {
        this._items.push(item);
    }

    public fn get(index: i32): T {
        return this._items[index];
    }
}

// 3.2 고차 타입 파라미터
public struct Functor<F<_>> {
    public fn map<A, B>(fa: F<A>, f: fn(A) -> B): F<B>;
}

public struct Bifunctor<F<_, _>> {
    public fn bimap<A, B, C, D>(fab: F<A, B>, f: fn(A) -> C, g: fn(B) -> D): F<C, D>;
}

// 3.3 타입 제약과 기본 타입
public struct Sorter<T: Comparable> {
    public fn sort(items: Vector<T>): Vector<T>;
}

public struct Optional<T = any> {
    private _value: T | null;
}

// 3.4 특수화
public struct Container<number> {
    private _items: Vector<number>;

    public fn sum(): number {
        return this._items.reduce((a, b) => a + b, 0);
    }

    public fn average(): number {
        return this.sum() / this._items.length;
    }
}

// 3.5 특수화 위임
public struct Container<string> by Container<number> {
    public fn join(separator: string): string {
        return this._items.join(separator);
    }
}

// 3.6 고차 타입 특수화
public struct Either<L, R> by Bifunctor<Either> {
    private _value: L | R;
    private _isLeft: bool;

    public fn bimap<A, B, C, D>(fab: Either<A, B>, f: fn(A) -> C, g: fn(B) -> D): Either<C, D> {
        return fab._isLeft ? 
            Either.left(f(fab._value as A)) : 
            Either.right(g(fab._value as B));
    }
}

// 3.7 와일드카드 타입
public struct Transformer<F<?>, G<?>> {
    public fn transform<A>(fa: F<A>): G<A>;
}

// 3.8 타입 별칭
using Maybe<T> = Option<T>;
using Result<T> = Either<string, T>;
using Future<T> = Promise<T>;

// 3.9 제네릭 함수
public fn sequence<F<_>, A>(fas: Vector<F<A>>): F<Vector<A>> 
    where F: Applicative<F> {
    return fas.reduce(
        (acc, fa) => acc.bind(as => fa.map(a => as.concat([a]))),
        F.pure([])
    );
}

// 3.10 제네릭 컴포지션
public struct Compose<F<_>, G<_>> {
    public type T<A> = F<G<A>>;
}

public struct Product<F<_>, G<_>> {
    public type T<A> = [F<A>, G<A>];
}

// 3.11 제네릭 사용 예제
let maybeList: Maybe<List<number>> = Maybe.some(List.from([1, 2, 3]));
let transformed = maybeList.map(list => list.map(x => x * 2));

// 3.12 제네릭 트랜스포머
public struct ReaderT<F<_>, R, A> by Functor<F> {
    private _run: fn(R) -> F<A>;

    public fn map<B>(f: fn(A) -> B): ReaderT<F, R, B> 
        where F: Functor<F> {
        return ReaderT.new(r => this._run(r).map(f));
    }
} 