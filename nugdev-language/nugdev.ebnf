(* ================================================= *)
(* COMPLETE EBNF GRAMMAR FOR NUGDEV LANGUAGE        *)
(* ================================================= *)

(* ================================================= *)
(* PROGRAM STRUCTURE                                 *)
(* ================================================= *)

program = { module } ;
module = { module_declaration } ;
module_declaration = [ module_modifier ] ( import_statement | export_statement | statement | namespace_declaration ) ;

(* ================================================= *)
(* MODULE SYSTEM                                     *)
(* ================================================= *)

(* Module Declaration *)
module_modifier = "export" | "static" | "public" | "private" ;

(* Import Statement *)
import_statement = "import" import_path [ "as" identifier ] [ ";" ] ;
import_path = string_literal | namespace_access ;
import_type = import_specific | import_renamed ;
import_specific = "{" import_item { "," import_item } [ "," ] "}" ;
import_item = identifier [ "as" identifier ] ;
import_renamed = identifier "as" identifier ;

(* Export Statement *)
export_statement = "export" export_item [ ";" ] ;
export_item = export_specific | export_renamed ;
export_specific = "{" export_member { "," export_member } [ "," ] "}" ;
export_member = identifier [ "as" identifier ] ;
export_renamed = identifier "as" identifier ;

(* Namespace Declaration *)
namespace_declaration = [ module_modifier ] "namespace" identifier "{" { namespace_member } "}" [ ";" ] ;
namespace_member = import_statement | export_statement | using_declaration | statement | namespace_declaration ;

(* Module Rules *)
module_rules = "(* Module Rules:
    1. 모듈은 단일 책임 원칙을 따름
    2. 모듈은 순환 의존성을 피해야 함
    3. 모듈은 명확한 인터페이스를 가져야 함
    4. 모듈은 캡슐화를 지원해야 함
    5. 모듈은 재사용 가능해야 함
    6. 모듈은 테스트 가능해야 함
    7. 모듈은 문서화되어야 함
    8. import와 export는 명시적이어야 함
*)" ;

(* ================================================= *)
(* MODULE SYSTEM                                     *)
(* ================================================= *)

import_statement = "import" string_literal [ "as" identifier ] [ ";" ] ;
export_statement = "export" ( identifier | "*" ) [ ";" ] ;
namespace_declaration = "namespace" identifier "{" { namespace_member } "}" [ ";" ] ;
namespace_member = import_statement | export_statement | statement | namespace_declaration ;

(* ================================================= *)
(* MODIFIERS                                         *)
(* ================================================= *)

access_modifier = "public" | "private" ;
static_modifier = "static" ;

(* Modifier Rules *)
modifier_rules = "(* Modifier Rules:
    1. public: 모든 곳에서 접근 가능
    2. private: 선언된 모듈 내부에서만 접근 가능
    3. static: 타입 레벨의 멤버임을 나타냄
    4. export: 모듈 외부로 노출됨을 나타냄
*)" ;

(* ================================================= *)
(* STATEMENTS                                        *)
(* ================================================= *)

statement = declaration_statement | control_statement | expression_statement ;
declaration_statement = [ module_modifier ] ( variable_declaration | function_declaration | struct_declaration | interface_declaration | property_declaration | union_declaration | enum_declaration | specialization | bitfield_declaration | using_declaration ) ;
control_statement = if_statement | loop_statement | break_statement | continue_statement | return_statement | try_statement | throw_statement ;
expression_statement = expression ";" ;

(* ================================================= *)
(* VARIABLE DECLARATIONS                             *)
(* ================================================= *)

variable_declaration = [ access_modifier ] ( "let" | "mut" ) identifier ":" type_literal [ "=" expression ] [ ";" ] ;

(* ================================================= *)
(* FUNCTION DECLARATIONS                             *)
(* ================================================= *)

function_declaration = [ module_modifier ] [ access_modifier ] [ static_modifier ] [ "async" ] "fn" identifier [ "<" type_parameter_list ">" ] "(" [ parameter_list ] ")" ":" type_literal function_body ;
function_body = block_body | arrow_body ;
block_body = "{" { statement } "}" ;
arrow_body = "=>" expression [ ";" ] ;
parameter_list = parameter { "," parameter } ;
parameter = ( "let" | "mut" ) identifier ":" type_literal [ "=" expression ] ;

(* ================================================= *)
(* STRUCT DECLARATIONS                               *)
(* ================================================= *)

struct_declaration = [ access_modifier ] "struct" identifier [ "<" type_parameter_list ">" ] [ "by" (identifier | type_literal) ] "{" [ struct_member_list ] "}" [ ";" ] ;
struct_member_list = struct_member { "," struct_member } [ "," ] ;
struct_member = [ access_modifier ] [ static_modifier ] (method_declaration | property_declaration | field_declaration) ;
field_declaration = identifier ":" type_literal [ "=" expression ] [ ";" ] ;

(* ================================================= *)
(* INTERFACE DECLARATIONS                            *)
(* ================================================= *)

interface_declaration = [ access_modifier ] "interface" identifier [ "<" type_parameter_list ">" ] "{" [ interface_member_list ] "}" [ ";" ] ;
interface_member_list = interface_member { "," interface_member } [ "," ] ;
interface_member = [ access_modifier ] [ static_modifier ] (method_signature | property_signature) ;
method_signature = identifier "(" [ parameter_list ] ")" ":" type_literal ;
property_signature = identifier ":" type_literal ;

(* ================================================= *)
(* PROPERTY DECLARATIONS                             *)
(* ================================================= *)

property_declaration = [ access_modifier ] "property" identifier ":" type_literal [ property_delegation ] property_body ;
property_body = "{" [ getter ] [ setter ] "}" ;
getter = [ access_modifier ] "get" "(" ")" ":" type_literal "=>" expression [ ";" ] ;
setter = [ access_modifier ] "set" "(" identifier ":" type_literal ")" ":" type_literal "=>" expression [ ";" ] ;

(* ================================================= *)
(* DELEGATION SYSTEM                                 *)
(* ================================================= *)

(* Delegation Types *)
delegation_type = property_delegation | bitfield_delegation | specialization_delegation ;

(* Property Delegation *)
property_delegation = "by" expression ;
property_delegation_chain = property_delegation { "," property_delegation } ;  (* 최대 한 번의 위임만 허용 *)

(* Bitfield Delegation *)
bitfield_delegation = "by" type_literal ;  (* 기반 타입 지정 *)
bitfield_member = [ access_modifier ] identifier ":" number_literal [ "=" expression ] [ ";" ] ;

(* Specialization Delegation *)
specialization_delegation = "by" identifier "<" type_argument_list ">" ;  (* 특수화 위임 *)
type_argument_list = type_literal { "," type_literal } ;

(* Delegation Rules *)
delegation_rules = "(* Delegation Rules:
    1. Property delegation: 다른 객체의 프로퍼티를 위임받음
    2. Bitfield delegation: 기반 타입의 비트 필드를 위임받음
    3. Specialization delegation: 특수화를 위임받음
    4. 위임은 최대 한 번만 허용됨
    5. 위임된 멤버는 원본 멤버의 접근 제어를 따름
    6. 위임된 멤버는 원본 멤버의 타입을 유지해야 함
    7. 위임된 멤버는 원본 멤버의 제약조건을 만족해야 함
*)" ;

(* ================================================= *)
(* UNION DECLARATIONS                                *)
(* ================================================= *)

union_declaration = [ access_modifier ] "union" identifier "{" [ union_variant_list ] "}" [ ";" ] ;
union_variant_list = union_variant { "," union_variant } [ "," ] ;
union_variant = [ access_modifier ] identifier ":" type_literal ;

(* ================================================= *)
(* BITFIELD SYSTEM                                   *)
(* ================================================= *)

(* Bitfield Types *)
bitfield_type = primitive_bitfield | composite_bitfield ;
primitive_bitfield = "u8" | "u16" | "u32" | "u64" | "i8" | "i16" | "i32" | "i64" ;
composite_bitfield = "struct" | "union" ;

(* Bitfield Declaration *)
bitfield_declaration = [ access_modifier ] "bitfield" identifier bitfield_delegation "{" { bitfield_member } "}" [ ";" ] ;

(* Bitfield Member *)
bitfield_member = [ access_modifier ] identifier ":" bitfield_specification [ "=" expression ] [ ";" ] ;
bitfield_specification = number_literal ;  (* 비트 수 지정 *)

(* Bitfield Rules *)
bitfield_rules = "(* Bitfield Rules:
    1. 기반 타입은 반드시 정수형이어야 함 (u8, u16, u32, u64, i8, i16, i32, i64)
    2. 비트 수는 기반 타입의 크기를 초과할 수 없음
    3. 비트 필드의 총 크기는 기반 타입의 크기와 일치해야 함
    4. 비트 필드는 메모리 정렬을 고려하여 배치됨
    5. 비트 필드는 기본적으로 unsigned로 처리됨
    6. 비트 필드의 기본값은 0
    7. 비트 필드는 패킹(packing)을 지원함
*)" ;

(* Bitfield Operations *)
bitfield_operation = bitfield_read | bitfield_write | bitfield_clear | bitfield_set | bitfield_toggle ;
bitfield_read = identifier "." identifier ;
bitfield_write = identifier "." identifier "=" expression ;
bitfield_clear = identifier "." identifier "=" "0" ;
bitfield_set = identifier "." identifier "=" "1" ;
bitfield_toggle = identifier "." identifier "^=" "1" ;

(* Bitfield Pattern Matching *)
bitfield_pattern = bitfield_identifier_pattern | bitfield_value_pattern ;
bitfield_identifier_pattern = identifier "." identifier ;
bitfield_value_pattern = bitfield_identifier_pattern "=" expression ;

(* ================================================= *)
(* TEMPLATE DECLARATIONS                             *)
(* ================================================= *)

template_declaration = [ access_modifier ] "template" identifier "<" type_parameter_list ">" "{" [ template_member_list ] "}" [ ";" ] ;
template_parameter_list = type_parameter { "," type_parameter } ;
template_parameter = identifier [ ":" type_constraint ] [ "=" default_type ] | higher_kinded_parameter ;
higher_kinded_parameter = identifier "<" type_parameter_list ">" [ ":" type_constraint ] [ "=" default_type ] ;
type_parameter = identifier | wildcard_type ;
wildcard_type = "_" | "?" | "*" ;
type_constraint = type_literal | type_constraint_expression | higher_kinded_constraint ;
higher_kinded_constraint = identifier "<" type_parameter_list ">" ;
default_type = type_literal | higher_kinded_type ;
higher_kinded_type = identifier "<" type_parameter_list ">" ;
template_member_list = template_member { "," template_member } [ "," ] ;
template_member = [ access_modifier ] [ static_modifier ] (method_declaration | property_declaration | field_declaration) ;

(* ================================================= *)
(* TEMPLATE SPECIALIZATION                            *)
(* ================================================= *)

specialization = struct_specialization | interface_specialization | function_specialization ;
struct_specialization = "struct" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "{" [ struct_member_list ] "}" [ ";" ] ;
interface_specialization = "interface" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "{" [ interface_member_list ] "}" [ ";" ] ;
function_specialization = [ "static" ] "fn" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "(" [ parameter_list ] ")" ":" type_literal function_body ;

(* ================================================= *)
(* CONTROL FLOW STATEMENTS                           *)
(* ================================================= *)

if_statement = "if" [ "(" expression ")" ] "{" { statement_or_expression } "}"
               { "elif" [ "(" expression ")" ] "{" { statement_or_expression } "}" }
               [ "else" "{" { statement_or_expression } "}" ] ;

loop_statement = for_statement | while_statement ;
for_statement = [ label ] "for" for_clause "{" { statement_or_expression } "}" ;
for_clause = (* empty *)                                                    (* infinite loop *)
           | "(" expression ")"                                             (* while-style *)
           | "(" variable_declaration ";" expression ")"                    (* init; condition *)
           | "(" variable_declaration ";" expression ";" expression ")"     (* init; condition; increment *)
           | "(" pattern "in" expression ")" ;                             (* for-in loop *)

while_statement = [ label ] "while" expression "{" { statement_or_expression } "}" ;

break_statement = [ label ] "break" [ ";" ] ;
continue_statement = [ label ] "continue" [ ";" ] ;
return_statement = [ label ] "return" [ expression ] [ ";" ] ;
label = identifier "@" ;

(* ================================================= *)
(* EXCEPTION HANDLING SYSTEM                          *)
(* ================================================= *)

(* Exception Types *)
exception_type = builtin_exception | custom_exception ;
builtin_exception = "Error" | "TypeError" | "ValueError" | "RuntimeError" | "ArithmeticError" | "IndexError" | "KeyError" | "IOError" | "NetworkError" | "TimeoutError" ;
custom_exception = identifier ;

(* Exception Declaration *)
exception_declaration = [ access_modifier ] "exception" identifier [ "extends" exception_type ] "{" [ exception_member_list ] "}" [ ";" ] ;
exception_member_list = exception_member { "," exception_member } [ "," ] ;
exception_member = [ access_modifier ] (method_declaration | property_declaration | field_declaration) ;

(* Try Statement *)
try_statement = "try" "{" { statement } "}" 
                { "catch" "(" parameter ")" "{" { statement } "}" }
                [ "finally" "{" { statement } "}" ] ;

(* Throw Statement *)
throw_statement = "throw" expression [ ";" ] ;

(* Exception Handling Rules *)
exception_handling_rules = "(* Exception Handling Rules:
    1. 예외는 반드시 처리되어야 함
    2. 예외는 타입 안전성을 보장해야 함
    3. 예외는 스택 트레이스를 포함해야 함
    4. 예외는 메시지를 포함해야 함
    5. 예외는 컨텍스트 정보를 포함해야 함
    6. 예외는 복구 가능한 상태를 유지해야 함
    7. 예외는 리소스를 정리해야 함
*)" ;

(* Exception Context *)
exception_context = try_statement | throw_statement | exception_declaration ;

(* Exception Propagation *)
exception_propagation = "throws" exception_type { "," exception_type } ;

(* ================================================= *)
(* EXPRESSIONS                                       *)
(* ================================================= *)

expression = assignment_expression ;
assignment_expression = conditional_expression [ assignment_operator assignment_expression ] ;
assignment_operator = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "~=" ;

conditional_expression = null_coalescing_expression [ "?" expression ":" expression ] ;
null_coalescing_expression = logical_or_expression { "??" logical_or_expression } ;
logical_or_expression = logical_and_expression { "or" logical_and_expression } ;
logical_and_expression = bitwise_or_expression { "and" bitwise_or_expression } ;
bitwise_or_expression = bitwise_xor_expression { "|" bitwise_xor_expression } ;
bitwise_xor_expression = bitwise_and_expression { "^" bitwise_and_expression } ;
bitwise_and_expression = equality_expression { "&" equality_expression } ;
equality_expression = relational_expression { ( "==" | "!=" ) relational_expression } ;
relational_expression = type_check_expression { ( "<" | ">" | "<=" | ">=" ) type_check_expression } ;
type_check_expression = shift_expression { "is" type_literal } ;
shift_expression = additive_expression { ( "<<" | ">>" ) additive_expression } ;
additive_expression = multiplicative_expression { ( "+" | "-" ) multiplicative_expression } ;
multiplicative_expression = unary_expression { ( "*" | "/" | "%" ) unary_expression } ;
unary_expression = ( "+" | "-" | "!" | "~" | "++" | "--" ) unary_expression | postfix_expression ;
postfix_expression = primary_expression { postfix_operator } ;
postfix_operator = "++" | "--" | member_access | "?." identifier | "[" expression "]" | "(" [ argument_list ] ")" | cast_operator ;
cast_operator = "as" type_literal | "as?" type_literal ;

(* ================================================= *)
(* PRIMARY EXPRESSIONS                               *)
(* ================================================= *)

primary_expression = identifier | namespace_access | literal | "(" expression ")" | array_literal | object_literal | block_expression | if_expression | when_expression | function_expression | await_expression ;

(* ================================================= *)
(* LITERALS                                          *)
(* ================================================= *)

literal = number_literal | string_literal | character_literal | boolean_literal | null_literal | none_literal | range_literal ;
number_literal = integer_literal | floating_point_literal ;
integer_literal = decimal_integer | binary_integer | octal_integer | hexadecimal_integer ;
decimal_integer = DIGIT { DIGIT | "_" } ;
binary_integer = "0b" BINARY_DIGIT { BINARY_DIGIT | "_" } ;
octal_integer = "0o" OCTAL_DIGIT { OCTAL_DIGIT | "_" } ;
hexadecimal_integer = "0x" HEX_DIGIT { HEX_DIGIT | "_" } ;
floating_point_literal = DIGIT { DIGIT | "_" } "." { DIGIT | "_" } [ exponent ] | DIGIT { DIGIT | "_" } exponent ;
exponent = ( "e" | "E" ) [ "+" | "-" ] DIGIT { DIGIT } ;

string_literal = simple_string | raw_string | template_string ;
simple_string = "\"" { string_character } "\"" ;
string_character = ESCAPE_SEQUENCE | ~( "\"" | "\\" | NEWLINE ) ;
raw_string = "r\"" { ~"\"" } "\"" ;
template_string = "`" { template_character | template_expression } "`" ;
template_character = ESCAPE_SEQUENCE | ~( "`" | "$" ) ;
template_expression = "${" expression "}" ;

character_literal = "'" ( ESCAPE_SEQUENCE | ~( "'" | "\\" | NEWLINE ) ) "'" ;
boolean_literal = "true" | "false" ;
null_literal = "null" ;
none_literal = "None" ;
range_literal = expression ".." [ expression ] ;

(* ================================================= *)
(* COLLECTION LITERALS                               *)
(* ================================================= *)

array_literal = "[" [ expression_list ] "]" | array_comprehension ;
array_comprehension = "[" expression "for" identifier "in" expression [ "if" expression ] "]" ;
object_literal = "{" [ property_list ] "}" ;
property_list = property { "," property } [ "," ] ;
property = property_name ":" expression | "[" expression "]" ":" expression | identifier | "." identifier "=" expression | "..." expression ;
property_name = identifier | string_literal | number_literal ;
expression_list = expression { "," expression } [ "," ] ;

(* ================================================= *)
(* TYPE LITERALS                                     *)
(* ================================================= *)

type_literal = namespace_access [ "<" type_argument_list ">" ] | complex_type ;
type_argument_list = type_literal { "," type_literal } ;
complex_type = function_type | optional_type | tuple_type | template_type ;
function_type = "(" [ type_list ] ")" "->" type_literal ;
optional_type = type_literal "?" ;
tuple_type = "(" type_literal "," type_list ")" ;
type_list = type_literal { "," type_literal } ;
template_type = identifier "<" type_argument_list ">" ;

(* ================================================= *)
(* PATTERN MATCHING SYSTEM                           *)
(* ================================================= *)

(* Pattern Types *)
pattern = identifier_pattern | tuple_pattern | array_pattern | object_pattern | type_pattern | literal_pattern | rest_pattern | struct_pattern | bitfield_pattern | union_pattern | range_pattern | guard_pattern ;

(* Basic Patterns *)
identifier_pattern = identifier [ ":" type_literal ] ;
literal_pattern = number_literal | string_literal | character_literal | boolean_literal | null_literal | none_literal ;

(* Collection Patterns *)
tuple_pattern = "(" [ pattern { "," pattern } [ "," ] ] ")" ;
array_pattern = "[" [ pattern { "," pattern } [ "," ] ] "]" ;
object_pattern = "{" [ property_pattern { "," property_pattern } [ "," ] ] "}" ;
property_pattern = (identifier | string_literal) ":" pattern ;

(* Type Patterns *)
type_pattern = type_literal "(" pattern ")" ;
struct_pattern = type_literal "{" [ struct_property_pattern { "," struct_property_pattern } [ "," ] ] "}" ;
struct_property_pattern = (identifier | string_literal) [ ":" pattern ] [ "=" expression ] ;
union_pattern = type_literal "." identifier [ "(" pattern ")" ] ;

(* Special Patterns *)
rest_pattern = "..." identifier ;
range_pattern = expression ".." [ expression ] ;
guard_pattern = pattern "if" expression ;

(* Pattern Matching Rules *)
pattern_matching_rules = "(* Pattern Matching Rules:
    1. 패턴은 중첩될 수 있음
    2. 패턴은 타입 안전성을 보장해야 함
    3. 패턴은 컴파일 타임에 검증됨
    4. 패턴은 변수 바인딩을 지원함
    5. 패턴은 가드를 지원함
    6. 패턴은 나머지 연산자를 지원함
    7. 패턴은 타입 패턴을 지원함
*)" ;

(* Pattern Matching Contexts *)
pattern_matching_context = when_expression | if_statement | for_statement | variable_declaration | parameter_declaration ;

(* When Expression *)
when_expression = "when" expression "{" { when_branch } "}" ;
when_branch = pattern [ "if" expression ] "=>" expression [ ";" ] ;

(* ================================================= *)
(* NAMESPACE ACCESS                                  *)
(* ================================================= *)

(* Namespace Access *)
namespace_access = identifier { "::" identifier } ;

(* ================================================= *)
(* TERMINAL SYMBOLS                                  *)
(* ================================================= *)

identifier = IDENTIFIER ;
ESCAPE_SEQUENCE = "\\" ( "n" | "t" | "r" | "\\" | "\"" | "'" | "0" | "u" HEX_DIGIT{4} ) ;
IDENTIFIER = LETTER { LETTER | DIGIT | "_" } ;
LETTER = "a".."z" | "A".."Z" | "_" ;
DIGIT = "0".."9" ;
BINARY_DIGIT = "0" | "1" ;
OCTAL_DIGIT = "0".."7" ;
HEX_DIGIT = "0".."9" | "a".."f" | "A".."F" ;
NEWLINE = "\n" | "\r\n" | "\r" ;
WHITESPACE = " " | "\t" | NEWLINE ;

(* ================================================= *)
(* COMMENTS                                          *)
(* ================================================= *)

line_comment = "#" { ~NEWLINE } NEWLINE ;
block_comment = "/*" { ~"*/" } "*/" ;

(* ================================================= *)
(* BASIC ASYNC TYPES                                 *)
(* ================================================= *)

(* Basic Async Types *)
async_type = "Promise" ;
async_generic_type = async_type "<" type_literal ">" ;

(* Basic Async Function *)
async_function = [ module_modifier ] [ access_modifier ] [ static_modifier ] "async" "fn" identifier [ "<" template_parameter_list ">" ] "(" [ parameter_list ] ")" ":" async_generic_type function_body ;

(* Async Rules *)
async_rules = "(* Async Rules:
    1. 비동기 프로그래밍은 라이브러리 레벨에서 구현됨
    2. 기본 비동기 타입만 언어에서 제공함
    3. 비동기 제어 흐름은 라이브러리로 구현 가능
    4. 비동기 오류 처리도 라이브러리로 구현 가능
    5. 비동기 함수는 반드시 비동기 타입을 반환해야 함
*)" ;

(* ================================================= *)
(* MEMBER ACCESS                                     *)
(* ================================================= *)

(* Member Access *)
member_access = instance_access | static_access ;
instance_access = expression "." identifier ;
static_access = namespace_access "::" identifier ;

(* Postfix Expression *)
postfix_expression = primary_expression { postfix_operator } ;
postfix_operator = "++" | "--" | member_access | "?." identifier | "[" expression "]" | "(" [ argument_list ] ")" | cast_operator ;

(* Member Access Rules *)
member_access_rules = "(* Member Access Rules:
    1. 인스턴스 멤버는 . 연산자로 접근
    2. 정적 멤버는 :: 연산자로 접근
    3. 네임스페이스 멤버는 :: 연산자로 접근
    4. 옵셔널 체이닝은 ?. 연산자로 접근
    5. 정적 멤버는 타입::멤버 형식으로 접근
    6. 인스턴스 멤버는 객체.멤버 형식으로 접근
*)" ;

(* ================================================= *)
(* NAMESPACE SYSTEM                                  *)
(* ================================================= *)

(* Namespace Rules *)
namespace_rules = "(* Namespace Rules:
    1. 네임스페이스는 모듈 수준의 export/import를 지원
    2. 네임스페이스는 using 키워드로 다른 네임스페이스를 가져올 수 있음
    3. 네임스페이스 내부의 멤버는 네임스페이스의 접근 제어를 따름
    4. 중첩된 네임스페이스는 부모 네임스페이스의 접근 제어를 따름
*)" ;

(* ================================================= *)
(* USING DECLARATIONS                                *)
(* ================================================= *)

(* Using Declaration *)
using_declaration = type_alias | namespace_alias | using_directive ;
type_alias = "using" identifier "=" type_literal [ ";" ] ;
namespace_alias = "using" identifier "=" namespace_access [ ";" ] ;
using_directive = "using" "namespace" namespace_access [ ";" ] ;

(* Using Rules *)
using_rules = "(* Using Rules:
    1. 타입 별칭: using NewType = ExistingType;
    2. 네임스페이스 별칭: using Alias = Namespace::Path;
    3. using 지시문: using namespace Namespace::Path;
    4. using은 선언된 스코프에서만 유효
    5. using은 중첩된 스코프에서 재정의 가능
    6. 네임스페이스 내부의 using은 해당 네임스페이스 내부에서만 유효
*)" ;

(* ================================================= *)
(* GENERIC SYSTEM                                    *)
(* ================================================= *)

(* Type Parameters *)
type_parameter_list = type_parameter { "," type_parameter } ;
type_parameter = identifier [ ":" type_constraint ] [ "=" default_type ] | higher_kinded_parameter ;
higher_kinded_parameter = identifier "<" type_parameter_list ">" [ ":" type_constraint ] [ "=" default_type ] ;
type_parameter = identifier | wildcard_type ;
wildcard_type = "_" | "?" | "*" ;
type_constraint = type_literal | type_constraint_expression | higher_kinded_constraint ;
higher_kinded_constraint = identifier "<" type_parameter_list ">" ;
default_type = type_literal | higher_kinded_type ;
higher_kinded_type = identifier "<" type_parameter_list ">" ;

(* Generic Declarations *)
struct_declaration = [ access_modifier ] "struct" identifier [ "<" type_parameter_list ">" ] "{" [ struct_member_list ] "}" [ ";" ] ;
interface_declaration = [ access_modifier ] "interface" identifier [ "<" type_parameter_list ">" ] "{" [ interface_member_list ] "}" [ ";" ] ;
function_declaration = [ module_modifier ] [ access_modifier ] [ static_modifier ] [ "async" ] "fn" identifier [ "<" type_parameter_list ">" ] "(" [ parameter_list ] ")" ":" type_literal function_body ;

(* Generic Specialization *)
specialization = struct_specialization | interface_specialization | function_specialization ;
struct_specialization = "struct" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "{" [ struct_member_list ] "}" [ ";" ] ;
interface_specialization = "interface" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "{" [ interface_member_list ] "}" [ ";" ] ;
function_specialization = [ "static" ] "fn" identifier "<" type_argument_list ">" [ "by" identifier "<" type_argument_list ">" ] "(" [ parameter_list ] ")" ":" type_literal function_body ;

(* Specialization Delegation *)
specialization_delegation = "by" identifier "<" type_argument_list ">" ;  (* 다른 특수화를 확장 *)
type_argument_list = type_literal { "," type_literal } ;

(* Generic Rules *)
generic_rules = "(* Generic Rules:
    1. 모든 선언(struct, interface, fn)은 타입 파라미터를 가질 수 있음
    2. 타입 파라미터는 제약조건과 기본 타입을 가질 수 있음
    3. 특수화는 기존 제네릭 선언의 특정 타입에 대한 구현을 제공
    4. 특수화는 다른 특수화를 확장할 수 있음 (extends)
    5. 고차 타입 파라미터는 다른 타입을 파라미터로 받는 타입을 지원
    6. 와일드카드 타입은 타입 파라미터의 유연성을 제공
*)" ;

(* Statement with Generics *)
statement = declaration_statement | control_statement | expression_statement ;
declaration_statement = [ module_modifier ] ( variable_declaration | function_declaration | struct_declaration | interface_declaration | property_declaration | union_declaration | enum_declaration | specialization | bitfield_declaration | using_declaration ) ;