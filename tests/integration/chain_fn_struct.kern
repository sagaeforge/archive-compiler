struct Vec2 { val x: i64, val y: i64 }

fn add(a: Vec2, b: Vec2) -> Vec2 {
    Vec2 { x: a.x + b.x, y: a.y + b.y }
}

fn dot(a: Vec2, b: Vec2) -> i64 {
    a.x * b.x + a.y * b.y
}

fn main() -> i64 {
    val a: Vec2 = Vec2 { x: 3, y: 4 }
    val b: Vec2 = Vec2 { x: 1, y: 2 }
    val c: Vec2 = add(a, b)
    dot(c, Vec2 { x: 3, y: 3 })
}
