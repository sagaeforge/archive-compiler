// Test sizeof() and alignof() compile-time intrinsics

struct Point {
    x: i64
    y: i64
}

fn main() -> i64 {
    val s1: u64 = sizeof(i64)
    val s2: u64 = sizeof(i32)
    val s3: u64 = sizeof(u8)
    val s4: u64 = sizeof(Point)
    val s5: u64 = sizeof(bool)

    val a1: u64 = alignof(i64)
    val a2: u64 = alignof(i32)
    val a3: u64 = alignof(u8)

    // s1(8) + s2(4) + s3(1) + s4(16) + s5(1) = 30
    // a1(8) + a2(4) + a3(1) = 13
    // total = 30 + 13 - 1 = 42
    (s1 + s2 + s3 + s4 + s5 + a1 + a2 + a3 - 1 as u64) as i64
}
