// Test array slicing syntax: arr[start..end]
fn sum_slice(s: Slice<i64>) -> i64 {
    var total: i64 = 0
    var i: u64 = 0u64
    while i < s.len {
        total = total + s[i]
        i = i + 1u64
    }
    total
}

fn main() -> i64 {
    var buf: [i64; 5] = [10, 8, 12, 7, 5]
    // Slice buf[1..4] → elements 8, 12, 7 → sum = 27
    val s: Slice<i64> = buf[1u64..4u64]
    val total: i64 = sum_slice(s)
    // Check len = 3
    val len_check: i64 = s.len as i64
    // 27 + 3 = 30, use exit code
    total + len_check
}
