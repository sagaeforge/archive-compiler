fn collatz_steps(n: i64) -> i64 {
    loop(x = n, steps = 0) {
        if x == 1 {
            break steps
        }
        if x - (x / 2) * 2 == 0 {
            continue(x / 2, steps + 1)
        }
        continue(3 * x + 1, steps + 1)
    }
}

fn main() -> i64 {
    val s: i64 = collatz_steps(27)
    if s > 100 { 42 } else { 0 }
}
