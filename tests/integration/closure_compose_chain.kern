fn add1(x: i64) -> i64 { x + 1 }
fn mul3(x: i64) -> i64 { x * 3 }

fn compose(f: fn(i64) -> i64, g: fn(i64) -> i64) -> fn(i64) -> i64 {
    { x: i64 => f(g(x)) }
}

fn main() -> i64 {
    val fg: fn(i64) -> i64 = compose(add1, mul3)
    val result1: i64 = fg(10)
    val result2: i64 = fg(5)
    result1 + result2
}
