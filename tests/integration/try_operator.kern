union Result<T, E> { Ok(T), Err(E) }

fn divide(a: i64, b: i64) -> Result<i64, i64> {
    if b == 0 {
        Result<i64, i64>::Err(0)
    } else {
        Result<i64, i64>::Ok(a / b)
    }
}

fn compute(x: i64) -> Result<i64, i64> {
    val a: i64 = divide(x, 2)?
    val b: i64 = divide(a, 1)?
    Result<i64, i64>::Ok(a + b)
}

fn main() -> i64 {
    val r: Result<i64, i64> = compute(84)
    match r {
        Ok(v) => v
        Err(_) => 0
    }
}
