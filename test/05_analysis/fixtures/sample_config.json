{
  "analysis_level": 1,
  "type_safety_level": 1,
  "optimization_level": 1,
  "memory_safety": {
    "enforce_null_safety": true,
    "enforce_bounds_checking": true,
    "enforce_ownership_rules": true,
    "allow_unsafe_operations": false,
    "detect_memory_leaks": true
  },
  "performance_analysis": {
    "analyze_complexity": true,
    "detect_inefficiencies": true,
    "suggest_optimizations": true,
    "max_recursion_depth": 1000,
    "performance_threshold": 0.1
  },
  "compile_time": {
    "enable_constexpr_evaluation": true,
    "enable_template_metaprogramming": true,
    "enable_static_assertions": true,
    "cache_compile_time_results": true,
    "max_cache_size": 10000,
    "aggressive_constant_folding": true
  },
  "error_reporting": {
    "show_warnings": true,
    "show_suggestions": true,
    "show_performance_hints": true,
    "max_errors_per_file": 100,
    "stop_on_first_error": false,
    "colorize_output": true
  },
  "ebnf_compliance": {
    "enforce_strict_grammar": true,
    "check_operator_precedence": true,
    "validate_reserved_keywords": true,
    "detect_missing_features": true,
    "suggest_ebnf_fixes": true
  },
  "analyzers": {
    "enable_semantic_analysis": true,
    "enable_type_checking": true,
    "enable_control_flow_analysis": true,
    "enable_data_flow_analysis": true,
    "enable_memory_safety_analysis": true,
    "enable_performance_analysis": true,
    "enable_compile_time_evaluation": true,
    "enable_ebnf_compliance_check": true,
    "enable_static_analysis": true,
    "enable_meta_programming": true
  }
} 